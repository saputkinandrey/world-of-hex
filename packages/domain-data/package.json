{
    "name": "@wohex/domain-data",
    "private": true,
    "version": "0.0.0",
    "type": "commonjs",
    "scripts": {
        "combat:test": "npm run build && node --test scripts/combat.test.cjs",
        "equipment:generate": "node scripts/generate-equipment.cjs",
        "equipment:test": "npm run build && node --test scripts/equipment.test.cjs",
        "build": "npm run equipment:generate && node scripts/clean-dist.cjs && tsc -p tsconfig.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            "rps/combat": [
                "dist/rps/combat/index.d.ts"
            ],
            "rps/characters": [
                "dist/rps/characters/index.d.ts"
            ],
            "rps/characters/*": [
                "dist/rps/characters/*"
            ],
            "economy": [
                "dist/economy/index.d.ts"
            ],
            "rps": [
                "dist/rps/index.d.ts"
            ],
            "rps/from-gpt": [
                "dist/rps/from-gpt/index.d.ts"
            ],
            "rps/from-gpt/*": [
                "dist/rps/from-gpt/*"
            ],
            "rps/social": [
                "dist/rps/social/types.d.ts"
            ],
            "rps/equipment": [
                "dist/rps/equipment/index.d.ts"
            ],
            "rps/world/*": [
                "dist/rps/world/*"
            ],
            "rps/types/*": [
                "dist/rps/types/*"
            ],
            "sea-combat": [
                "dist/sea-combat/index.d.ts"
            ],
            "sea-combat/*": [
                "dist/sea-combat/*"
            ]
        }
    },
    "exports": {
        "./rps/combat": {
            "types": "./dist/rps/combat/index.d.ts",
            "default": "./dist/rps/combat/index.js"
        },
        "./rps/characters": {
            "types": "./dist/rps/characters/index.d.ts",
            "default": "./dist/rps/characters/index.js"
        },
        "./rps/characters/*": {
            "types": "./dist/rps/characters/*.d.ts",
            "default": "./dist/rps/characters/*.js"
        },
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./economy": {
            "types": "./dist/economy/index.d.ts",
            "default": "./dist/economy/index.js"
        },
        "./rps": {
            "types": "./dist/rps/index.d.ts",
            "default": "./dist/rps/index.js"
        },
        "./rps/from-gpt": {
            "types": "./dist/rps/from-gpt/index.d.ts",
            "default": "./dist/rps/from-gpt/index.js"
        },
        "./rps/from-gpt/*": {
            "types": "./dist/rps/from-gpt/*.d.ts",
            "default": "./dist/rps/from-gpt/*.js"
        },
        "./rps/social": {
            "types": "./dist/rps/social/types.d.ts",
            "default": "./dist/rps/social/types.js"
        },
        "./rps/equipment": {
            "types": "./dist/rps/equipment/index.d.ts",
            "default": "./dist/rps/equipment/index.js"
        },
        "./rps/world/*": {
            "types": "./dist/rps/world/*.d.ts",
            "default": "./dist/rps/world/*.js"
        },
        "./rps/types/*": {
            "types": "./dist/rps/types/*.d.ts",
            "default": "./dist/rps/types/*.js"
        },
        "./sea-combat": {
            "types": "./dist/sea-combat/index.d.ts",
            "default": "./dist/sea-combat/index.js"
        },
        "./sea-combat/*": {
            "types": "./dist/sea-combat/*.d.ts",
            "default": "./dist/sea-combat/*.js"
        }
    }
}
